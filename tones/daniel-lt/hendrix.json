{
  "name": "Hendrix-ish",
  "device": "helix_lt",
  "tempo": 100,
  "notes": "Hendrix-style rig in his order: Vox wah, Fuzz Face, Octavia, Uni-Vibe, jumped Plexi, greenbacks. Snapshots are the four standing sounds (Clean, Crunch, Lead, Ambient) and change the amp, levels and effect mixes only; every stomp stays as the foot left it. Clean is the Plexi with the drives pulled back, as when the guitar volume comes down. Ambient switches in its own long reverb. Cab is a 57 with a 121 ribbon beside it for body (measured: about 2 dB more below 1 kHz, top unchanged). Bass is pulled well back from the model's default of 9.0. Built for the Powercab in flat mode. Not yet heard on the unit.",
  "chain": [
    {
      "id": "wah",
      "model": "UK Wah 846",
      "enabled": false,
      "stays": true
    },
    {
      "id": "fuzz",
      "model": "Arbitrator Fuzz",
      "enabled": false,
      "footswitch": 8,
      "stays": true,
      "params": {
        "Fuzz": 0.7,
        "Level": 0.45
      }
    },
    {
      "id": "octave",
      "model": "Tycoctavia Fuzz",
      "enabled": false,
      "footswitch": 2,
      "stays": true,
      "params": {
        "Fuzz": 0.6,
        "Level": 0.5
      }
    },
    {
      "id": "vibe",
      "model": "Ubiquitous Vibe",
      "enabled": false,
      "footswitch": 9,
      "stays": true,
      "params": {
        "Rate": 0.33,
        "Intensity": 0.8,
        "Mix": 0.5
      }
    },
    {
      "id": "vol",
      "model": "Volume",
      "stays": true
    },
    {
      "id": "amp",
      "model": "Brit Plexi Jump",
      "params": {
        "BrtDrive": 0.27,
        "NrmDrive": 0.2,
        "Bass": 0.5,
        "Mid": 0.8,
        "Treble": 0.65,
        "Presence": 0.6,
        "ChVol": 0.6,
        "Sag": 0.6
      }
    },
    {
      "id": "cab",
      "model": "4x12 Greenback 25",
      "params": {
        "Mic": "57 Dynamic",
        "HighCut": 7500,
        "LowCut": 85
      },
      "dual": {
        "model": "4x12 Greenback 25",
        "params": {
          "Mic": "121 Ribbon",
          "HighCut": 7500,
          "LowCut": 85
        }
      }
    },
    {
      "id": "trim",
      "model": "Gain"
    },
    {
      "id": "echo",
      "model": "Transistor Tape",
      "enabled": false,
      "footswitch": 10,
      "stays": true,
      "trails": true,
      "params": {
        "Time": 0.36,
        "Feedback": 0.3,
        "Mix": 0.22
      }
    },
    {
      "id": "verb",
      "model": "Plate",
      "footswitch": 11,
      "stays": true,
      "trails": true,
      "params": {
        "Decay": 0.35,
        "Mix": 0.15
      }
    },
    {
      "id": "space",
      "model": "Glitz",
      "enabled": false,
      "trails": true,
      "params": {
        "Decay": 0.7,
        "Mix": 0.3,
        "HighCut": 6000
      }
    }
  ],
  "snapshots": [
    {
      "name": "Clean",
      "colour": "turquoise",
      "set": {
        "amp": {
          "BrtDrive": 0.17,
          "NrmDrive": 0.12,
          "ChVol": 0.9999
        },
        "trim": {
          "Gain": 4.52
        }
      }
    },
    {
      "name": "Crunch",
      "colour": "light orange",
      "set": {
        "amp": {
          "BrtDrive": 0.27,
          "NrmDrive": 0.2,
          "ChVol": 0.8249
        }
      }
    },
    {
      "name": "Lead",
      "colour": "red",
      "set": {
        "amp": {
          "BrtDrive": 0.78,
          "NrmDrive": 0.62,
          "ChVol": 0.8881
        },
        "echo": {
          "Mix": 0.18
        }
      }
    },
    {
      "name": "Ambient",
      "colour": "violet",
      "on": [
        "space"
      ],
      "set": {
        "amp": {
          "BrtDrive": 0.17,
          "NrmDrive": 0.12,
          "ChVol": 0.9999
        },
        "echo": {
          "Mix": 0.35
        },
        "trim": {
          "Gain": 3.6
        }
      }
    }
  ]
}
